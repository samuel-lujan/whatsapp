# Configurações do Ambiente
NODE_ENV=development
# NODE_ENV=production

# Token de autenticação para a API
AUTH_TOKEN=sua-chave-secreta-aqui

# Rollbar para monitoramento de erros (opcional)
ROLLBAR_ACCESS_TOKEN=seu-token-rollbar-aqui

# Forçar modo headless independente do NODE_ENV (opcional)
# HEADLESS=true
# HEADLESS=false

# Token para a API do aplicativo
APP_TOKEN=seu-token-api-aqui

# Hash para controle de acesso à versão beta
BETA_HASH=sua-hash-aqui

# Chave da API OpenAI para transcrição de áudio
OPENAI_TRANSCRIBE_KEY=sua-chave-openai-aqui

# Habilitar ou desabilitar transcrição de áudio
TRANSCRIPTION=false
